# Reverse-engineer API (YouTube/X/Instagram/TikTok link or upload -> prompts) on Fly.io.
# Build context is the repo root:  fly launch --copy-config -c fly.reverse.toml --no-deploy && fly deploy -c fly.reverse.toml
FROM node:22-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl \
 && curl -fsSL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux -o /usr/local/bin/yt-dlp \
 && chmod a+rx /usr/local/bin/yt-dlp \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
ENV PUPPETEER_SKIP_DOWNLOAD=1
RUN npm ci --omit=dev --no-audit --no-fund
COPY server ./server
COPY prompts ./prompts
COPY site/api ./site/api
COPY site/package.json ./site/package.json
ENV NODE_ENV=production PORT=8080 CIZLE_DATA_DIR=/data
EXPOSE 8080
CMD ["node", "server/index.js"]
