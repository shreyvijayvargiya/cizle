	"edges": [
		{ "from": "G01", "to": "G02" },
		{ "from": "G02", "to": "W01" },
		{ "from": "W01", "to": "W06" },
		{ "from": "W06", "to": "W07" },
		{ "from": "W07", "to": "W08" },
		{ "from": "W08", "to": "W03" },
		{ "from": "W03", "to": "W05" }
