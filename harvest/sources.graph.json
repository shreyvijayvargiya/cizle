{
	"version": 1,
	"description": "The harvester's sources, as a graph. Nodes are sources; an edge says which source comes next. The engine walks it from `start` with a pointer, runs up to 3 nodes at once, and remembers progress in harvest/data/ so it can resume. Every node must be able to reach 100+ prompts (min_records).",
	"defaults": { "min_records": 100, "batch_size": 20, "batch_pause_ms": 8000, "source_pause_ms": 8000, "max_parallel": 3 },
	"start": "G01",
	"nodes": [
		{
			"id": "G01",
			"name": "yihui-dev/awesome-opus5-5-videos",
			"adapter": "json-dataset",
			"url": "https://github.com/yihui-dev/awesome-opus5-5-videos",
			"expect": 703,
			"verified": true,
			"config": { "url": "https://raw.githubusercontent.com/yihui-dev/awesome-opus5-5-videos/main/data/videos.json", "mapper": "yihui" },
			"notes": "One JSON file, 703 records; some prompts are partial (kept, flagged)."
		},
		{
			"id": "G02",
			"name": "LeaddeOpenLab/awesome-opus-5-5-video-prompts",
			"adapter": "github-files",
			"url": "https://github.com/LeaddeOpenLab/awesome-opus-5-5-video-prompts",
			"expect": 728,
			"verified": true,
			"config": { "repo": "LeaddeOpenLab/awesome-opus-5-5-video-prompts", "ref": "main", "dir": "data/library", "mapper": "leadde", "mode": "auto" },
			"notes": "728 JSON files, one per tweet id. Sparse git clone of data/library only (the repo is 360 MB of GIFs otherwise)."
		},
		{
			"id": "W01",
			"name": "Prompt Motion",
			"adapter": "prompt-motion",
			"url": "https://prompt-motion.com",
			"expect": 235,
			"verified": true,
			"config": { "origin": "https://prompt-motion.com" },
			"notes": "Server-rendered Next.js; home page lists everything. robots.txt: ai-train=no, use=reference. Reference use only."
		},
		{
			"id": "W06",
			"name": "YouMind video prompts",
			"adapter": "sitemap-gallery",
			"url": "https://youmind.com/opus-5-5-prompts",
			"verified": false,
			"config": {
				"list": [
					{ "mode": "sitemap", "url": "https://youmind.com/sitemap.xml", "childMatch": "video-prompts|prompts", "match": "/video-prompts/[a-z0-9-]+-\\d+/?$" },
					{ "mode": "scroll", "url": "https://youmind.com/opus-5-5-prompts", "linkMatch": "/video-prompts/[a-z0-9-]+-\\d+/?$", "maxScrolls": 200 }
				],
				"detail": { "mustInclude": "Opus 5\\.5|opus-5-5" }
			},
			"notes": "UNVERIFIED (blocked in the research sandbox). URL pattern from search results: /video-prompts/<slug>-<id>. Probe decides."
		},
		{
			"id": "W07",
			"name": "Carat prompt gallery",
			"adapter": "sitemap-gallery",
			"url": "https://carat.im/prompt-gallery/claude-opus-5-5",
			"verified": false,
			"config": {
				"list": [
					{ "mode": "page", "url": "https://carat.im/prompt-gallery/claude-opus-5-5", "param": "page", "start": 1, "linkMatch": "/prompt-gallery/p/\\d+/?$", "maxPages": 100 },
					{ "mode": "scroll", "url": "https://carat.im/prompt-gallery/claude-opus-5-5", "linkMatch": "/prompt-gallery/p/\\d+/?$", "maxScrolls": 200 }
				],
				"detail": { "mustInclude": "Opus 5\\.5|opus-5-5" }
			},
			"notes": "UNVERIFIED. Detail pages /prompt-gallery/p/<id> (ids 42164-42363 seen). The sitemap lists every model, so pagination/scroll of the Opus 5.5 page is used."
		},
		{
			"id": "W08",
			"name": "Jason Zhu prompt library",
			"adapter": "sitemap-gallery",
			"url": "https://jasonzhu.ai/en/prompts/claude-opus-5-5",
			"verified": false,
			"config": {
				"list": [
					{ "mode": "page", "url": "https://jasonzhu.ai/en/prompts/claude-opus-5-5", "param": "page", "start": 1, "linkMatch": "/en/prompts/claude-opus-5-5/[^/?#]+/?$", "maxPages": 100 },
					{ "mode": "scroll", "url": "https://jasonzhu.ai/en/prompts/claude-opus-5-5", "linkMatch": "/en/prompts/claude-opus-5-5/[^/?#]+/?$", "maxScrolls": 300 }
				],
