					{ "mode": "sitemap", "url": "https://promptcat.org/sitemap.xml", "match": "/(prompt|prompts|p)/[^/]+/?$" },
					{ "mode": "scroll", "url": "https://promptcat.org/", "linkMatch": "/(prompt|prompts|p)/[^/?#]+/?$", "maxScrolls": 200 }
