{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "npm install",
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"cleanUrls": true,
	"trailingSlash": false,
	"headers": [
		{
			"source": "/api/((?!vid).*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-store"
				}
			]
		},
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/skills/(.*).json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, s-maxage=3600"
				}
			]
		},
		{
			"source": "/(gallery|creators|skills)\\.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/versions\\.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/versions/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/gallery-text/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/mcp",
			"destination": "/api/mcp"
		}
	],
	"redirects": [
		{
			"source": "/search",
			"has": [
				{
					"type": "query",
					"key": "format"
				}
			],
			"destination": "/api/search",
			"permanent": false
		}
	]
}
