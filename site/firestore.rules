rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isPro() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn() && u.plan == 'pro' && u.proUntil > request.time;
    }

    // A person can read their own subscription. Only the webhook (Admin SDK, bypasses rules) can write it.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Premium prompts and SKILL.md files: readable only while the subscription is active, writable only by the seed script.
    match /premium/{slug} {
      allow read: if signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isPro();
      allow write: if false;
    }

    // Full text of premium gallery prompts: same rule as premium skills.
    match /gallery/{id} {
      allow read: if signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isPro();
      allow write: if false;
    }

    // Newsletter sign-ups from the landing page: anyone can add their own address (the document id is the address), nobody can read, change or list them.
    match /subscribers/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email == email
        && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
        && email.size() <= 254
        && request.resource.data.source is string && request.resource.data.source.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Public counters per prompt or skill (document id "p-<prompt id>" or "s-<skill slug>"): likes, bookmarks, views. Anyone can read.
    // A client may only move a counter by ONE per write (an increment of +1 or -1, never below zero) and may store nothing else.
    // Likes and bookmarks need a signed-in member; a view does not.
    function oldCount(f) { return resource == null ? 0 : resource.data.get(f, 0); }
    function newCount(f) { return request.resource.data.get(f, 0); }
    function stepOk(f) { return newCount(f) is int && newCount(f) >= 0 && math.abs(newCount(f) - oldCount(f)) <= 1; }
    function memberOk(f) { return newCount(f) == oldCount(f) || signedIn(); }
    match /stats/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['likes', 'bookmarks', 'views', 'updatedAt'])
        && stepOk('likes') && stepOk('bookmarks') && stepOk('views')
        && memberOk('likes') && memberOk('bookmarks');
      allow delete: if false;
    }

    // Webhook bookkeeping: never visible to clients.
    match /webhooks/{id} {
      allow read, write: if false;
    }
  }
}
