{
	"name": "cizle-site",
	"version": "0.1.0",
	"private": true,
	"description": "cizle skills marketplace: a static-first library of video skills and prompts for Claude Code. Firebase auth, Dodo Payments, no server except one webhook.",
	"type": "module",
	"scripts": {
		"content": "node scripts/build-content.mjs",
		"dev": "npm run content && vite",
		"build": "npm run content && tsc --noEmit && vite build && node scripts/prerender.mjs",
		"preview": "vite preview --port 4173",
		"typecheck": "tsc --noEmit",
		"seed:premium": "node scripts/seed-premium.mjs",
		"gallery:import": "node scripts/import-harvest.mjs",
		"seed:gallery": "node scripts/seed-gallery.mjs",
		"seed:gallery:dry": "node scripts/seed-gallery.mjs --dry",
		"test": "node tests/webhook.test.mjs && node tests/gallery.test.mjs",
		"seed:premium:dry": "node scripts/seed-premium.mjs --dry"
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/react": "^1.1.10",
		"@tanstack/react-query": "^5.85.5",
		"@tanstack/react-router": "^1.131.27",
		"canvas-confetti": "^1.9.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"firebase": "^11.10.0",
		"fuse.js": "^7.1.0",
		"radix-ui": "^1.4.3",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.12",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^22.10.0",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react": "^5.0.2",
		"firebase-admin": "^13.4.0",
		"gray-matter": "^4.0.3",
		"marked": "^17.0.3",
		"tailwindcss": "^4.1.12",
		"typescript": "^5.9.2",
		"vite": "^7.1.3"
	}
}
