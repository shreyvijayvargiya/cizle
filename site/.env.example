# Public site URL (canonical links, sitemap, install commands). Use your real domain.
VITE_SITE_URL=https://cizle.dev

# Firebase web app config (Firebase console > Project settings > Your apps). Enable Google and Email/Password sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Dodo Payments: three subscription products, each in USD and in INR (six products), payment link enabled on each, ids pasted here.
#   1 month   USD $20 / INR 1599, billed every 1 month
#   6 months  USD $90 (= $15 a month, 25% off) / INR 7194 (= 1199 a month), billed every 6 months
#   12 months USD $120 (= $10 a month, 50% off) / INR 9588 (= 799 a month), billed every 12 months
VITE_DODO_PRODUCT_MONTH_USD=
VITE_DODO_PRODUCT_MONTH_INR=
VITE_DODO_PRODUCT_HALF_USD=
VITE_DODO_PRODUCT_HALF_INR=
VITE_DODO_PRODUCT_YEAR_USD=
VITE_DODO_PRODUCT_YEAR_INR=
# Use https://test.checkout.dodopayments.com/buy while testing.
VITE_DODO_CHECKOUT_BASE=https://checkout.dodopayments.com/buy
# Customer portal link where people cancel or update their card (from the Dodo dashboard).
VITE_DODO_PORTAL_URL=
# Display prices in rupees PER MONTH (must match the INR products; the defaults are 1599, 1199 and 799).
# VITE_PRICE_INR_MONTH=1599
# VITE_PRICE_INR_HALF=1199
# VITE_PRICE_INR_YEAR=799

# Local testing only (npm run dev): act as a Premium subscriber without Firebase.
# VITE_DEV_UNLOCK=1

# ---- Server side, only for the one webhook function (api/dodo-webhook.ts) and the seed script. Never prefix with VITE_. ----
# Dodo dashboard > Developer > Webhooks: endpoint https://YOUR-DOMAIN/api/dodo-webhook, subscribe to subscription and payment events.
DODO_WEBHOOK_SECRET=
# Firebase console > Project settings > Service accounts > Generate key; paste the JSON on one line.
FIREBASE_SERVICE_ACCOUNT=

# Where the full text of premium gallery prompts comes from. Default "public": one small file per prompt under /gallery/text/, shown only to
# subscribers in the page (a soft gate: the file URL is public, so anyone who finds it can read it; no Firebase read or seeding needed).
# "firestore": strict, the text stays out of the site and is read from Firestore by subscribers (needs npm run seed:gallery and the service account).
# VITE_GALLERY_TEXT=public
