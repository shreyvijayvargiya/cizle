{
	"name": "cizle",
	"version": "0.1.0",
	"description": "Paste a SaaS URL or GitHub repo → get product showcase, feature, FAQ, comparison, glossary and launch videos. Local studio + markdown prompt library, powered by OpenRouter.",
	"license": "MIT",
	"type": "module",
	"private": true,
	"engines": { "node": ">=20.12" },
	"scripts": {
		"dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch-path=server server/index.js\" \"vite --config web/vite.config.ts\"",
		"build": "vite build --config web/vite.config.ts",
		"start": "node server/index.js",
		"typecheck": "tsc --noEmit -p web"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.5",
		"cheerio": "^1.1.2",
		"ffmpeg-static": "^5.2.0",
		"gray-matter": "^4.0.3",
		"hono": "^4.8.5",
		"marked": "^17.0.3",
		"puppeteer": "^24.17.0",
		"turndown": "^7.2.1",
		"uploadthing": "^7.7.4",
		"uuid": "^11.1.0"
	},
	"devDependencies": {
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/react": "^1.1.10",
		"@tailwindcss/vite": "^4.1.12",
		"@tanstack/react-query": "^5.85.5",
		"@tanstack/react-router": "^1.131.27",
		"@tanstack/react-table": "^8.21.3",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react": "^5.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"concurrently": "^9.2.1",
		"radix-ui": "^1.4.3",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.12",
		"typescript": "^5.9.2",
		"vite": "^7.1.3"
	}
}
