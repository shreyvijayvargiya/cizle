# Optional — you can also paste keys in the dashboard (Settings). Environment values win.
OPENROUTER_API_KEY=
# Optional: upload finished videos to UploadThing (otherwise they stay in ./data)
UPLOADTHING_TOKEN=
# Optional: use an existing Chrome instead of the one puppeteer downloads
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# PORT=3737
# Optional: only needed for PRIVATE repos (public repos are read with plain git, no API or token)
GITHUB_TOKEN=
